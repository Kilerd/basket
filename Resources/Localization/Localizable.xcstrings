          }
        }
      }
    },
    "Basket doesn't list %@ yet, so the archive was kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basket listet %@ noch nicht auf, daher wurde das Archiv behalten."
