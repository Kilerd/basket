    "container keeps a small background service for images, networks and container VMs. It uses almost no memory until you run a container." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "container betreibt einen kleinen Hintergrunddienst für Images, Netzwerke und Container-VMs. Er belegt fast keinen Arbeitsspeicher, bis du einen Container ausführst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "container exécute un petit service en arrière-plan pour les images, les réseaux et les VM des conteneurs. Il n’utilise presque pas de mémoire tant que vous n’exécutez pas de conteneur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "containerは、イメージ、ネットワーク、コンテナの仮想マシン用に小さなバックグラウンドサービスを常駐させます。コンテナを実行するまでメモリはほとんど使用しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "container 会保留一个小型后台服务，用于管理镜像、网络和容器虚拟机。在你运行容器之前，它几乎不占用内存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "container 會保留一個小型背景服務，用於管理映像檔、網路和容器虛擬機器。在你執行容器之前，它幾乎不使用記憶體。"
          }
        }
      }
    },
