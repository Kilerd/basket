    "Restart policy “%@” isn't supported: Basket doesn't restart the container when it exits or after a reboot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Neustartrichtlinie „%@“ wird nicht unterstützt: Basket startet den Container nicht neu, wenn er sich beendet oder der Mac neu startet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La stratégie de redémarrage « %@ » n’est pas prise en charge : Basket ne redémarre pas le conteneur lorsqu’il s’arrête, ni après un redémarrage du système."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再起動ポリシー「%@」はサポートされていません。Basketは、コンテナが終了したときやシステムの再起動後にコンテナを再起動しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持重新启动策略“%@”：容器退出时或系统重新启动后，Basket 都不会重新启动它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支援重新啟動原則「%@」：容器結束或重新開機後，Basket 不會重新啟動它。"
          }
        }
      }
    },
    "Restart the container to return about %@ to macOS. In-memory state is lost; published ports come back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte den Container neu, um etwa %@ an macOS zurückzugeben. Der Zustand im Arbeitsspeicher geht verloren; veröffentlichte Ports sind danach wieder da."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redémarrez le conteneur pour rendre environ %@ à macOS. L’état en mémoire est perdu ; les ports publiés reviennent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテナを再起動すると、約%@がmacOSに返されます。メモリ上の状態は失われますが、公開ポートは戻ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新启动容器可将约 %@ 归还给 macOS。内存中的状态会丢失；已发布的端口会恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新啟動容器，將約 %@ 歸還給 macOS。記憶體中的狀態會遺失；已發佈的連接埠會恢復。"
          }
        }
      }
    },
