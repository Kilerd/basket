        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Basket already has a different image named %1$@: %2$@. Rename or delete it in Basket to import OrbStack's."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basket contient déjà une autre image nommée %1$@ : %2$@. Renommez-la ou supprimez-la dans Basket pour importer celle d’OrbStack."
          }
