    "apple/container has no %@; services that use them won't see the files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "apple/container hat keine %@; Dienste, die sie verwenden, sehen die Dateien nicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "apple/container n’a pas d’équivalent pour %@ ; les services qui s’en servent ne verront pas les fichiers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "apple/containerには%@がありません。これらを使用するサービスからはファイルを参照できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "apple/container 没有 %@ 功能；使用它们的服务将看不到这些文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
