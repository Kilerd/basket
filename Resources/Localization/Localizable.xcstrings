    "Never stopped: containers started with --rm (stopping deletes them) and ones you exempt in their context menu or details." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie gestoppt werden: mit --rm gestartete Container (Stoppen löscht sie) und solche, die du im Kontextmenü oder in den Details ausnimmst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamais arrêtés : les conteneurs démarrés avec --rm (les arrêter les supprime) et ceux que vous excluez depuis leur menu contextuel ou leurs détails."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止されないもの：--rmで起動されたコンテナ（停止すると削除されるため）と、コンテキストメニューまたは詳細で除外したコンテナ。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永远不会停止：使用 --rm 启动的容器（停止会将其删除），以及你在其快捷菜单或详细信息中设为豁免的容器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永遠不會停止：以 --rm 啟動的容器（停止會將它們刪除），以及你在其快速選單或詳細資訊中排除的容器。"
          }
        }
      }
    },
    "Never stopped: containers started with --rm (stopping deletes them) and ones you exempt in their context menu or details. Exempt now: %@." : {
