    "%@ for %lld services" : {
      "comment" : "Memory limits: total for this many Compose services",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ for %2$lld service"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ for %2$lld services"
                }
              }
            }
          }
        }
      }
    },
    "%@ for other platforms" : {
      "comment" : "Status bar: disk space taken by other CPU architectures"
    },
    "%@ gets the named volume %@, so it survives restarts; Down with volumes removes it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ erhält das benannte Volume %2$@, das Neustarts übersteht; „Down“ mit Volumes entfernt es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ gets the named volume %2$@, so it survives restarts; Down with volumes removes it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ reçoit le volume nommé %2$@, qui est conservé entre les redémarrages ; Down avec suppression des volumes le supprime."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@には名前付きボリューム%2$@が割り当てられるため、再起動しても残ります。ボリュームも削除する「Down」を実行すると削除されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 将使用命名卷 %2$@，因此重新启动后数据仍会保留；执行 Down 并删除卷时会将其移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 會取得具名磁碟區 %2$@，因此重新啟動後仍會保留；執行 Down 並刪除磁碟區時會將它移除。"
          }
        }
      }
    },
    "%@ has a “%@” line without its end marker. Fix or remove it, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ enthält eine Zeile „%2$@“ ohne Endmarkierung. Korrigiere oder entferne sie und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has a “%2$@” line without its end marker. Fix or remove it, then try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ contient une ligne « %2$@ » sans marqueur de fin. Corrigez-la ou supprimez-la, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@に、終了マーカーのない「%2$@」行があります。修正するか削除してから、もう一度やり直してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 中有一行“%2$@”，但缺少对应的结束标记。请修正或移除该行，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 有一行「%2$@」，但缺少對應的結束標記。請修正或移除該行，然後再試一次。"
          }
        }
      }
    },
    "%@ has been idle for %@" : {
