    "Images and the volume %@ are kept, so Compose Up brings the data back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images und das Volume %@ bleiben erhalten, sodass Compose Up die Daten zurückbringt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images et le volume %@ sont conservés ; Compose Up retrouvera donc les données."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イメージとボリューム%@は保持されるため、Compose Upでデータが戻ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "镜像和卷 %@ 会保留，因此执行 Compose Up 即可恢复数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "映像檔和磁碟區 %@ 會保留，因此 Compose Up 可以找回資料。"
          }
        }
      }
    },
