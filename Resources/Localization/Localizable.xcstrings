    "Nothing is reserved up front: each container is its own VM with its memory limit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nichts im Voraus reserviert: Jeder Container ist eine eigene VM mit ihrem Arbeitsspeicherlimit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’est réservé à l’avance : chaque conteneur est une VM distincte, avec sa propre limite de mémoire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "事前に確保されるメモリはありません。各コンテナは、それぞれのメモリ上限を持つ独立した仮想マシンです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不会预先预留内存：每个容器都是独立的虚拟机，按自己的内存限制运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不會預先保留任何資源：每個容器都是具有自己記憶體限制的獨立虛擬機器。"
          }
        }
      }
    },
    "Nothing is reserved up front; the limits apply." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nichts im Voraus reserviert; die Limits gelten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’est réservé à l’avance ; les limites s’appliquent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "事前に確保されるリソースはありません。上限が適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不会预先预留资源；以限制值为准。"
