    "Anonymous volume" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymes Volume"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume anonyme"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匿名ボリューム"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匿名卷"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匿名磁碟區"
          }
        }
      }
    },
    "Anonymous volumes at %@ aren't recreated; their data stays in OrbStack and the container starts with what the image has there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyme Volumes unter %@ werden nicht neu erstellt; ihre Daten bleiben in OrbStack, und der Container startet mit dem, was das Image dort enthält."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les volumes anonymes montés sur %@ ne sont pas recréés ; leurs données restent dans OrbStack et le conteneur démarre avec le contenu de l’image à cet emplacement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の匿名ボリュームは再作成されません。データはOrbStackに残り、コンテナはその場所にイメージが持つ内容で起動します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不会重新创建 %@ 处的匿名卷；其数据保留在 OrbStack 中，容器启动时这些位置只有镜像自带的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不會重新建立位於 %@ 的匿名磁碟區；其資料會留在 OrbStack 中，容器啟動時會使用映像檔在該位置的內容。"
          }
        }
      }
    },
    "Anything kept only in memory (caches, sessions, unsaved work) is lost. Files and volumes are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was nur im Arbeitsspeicher liegt (Caches, Sitzungen, nicht gesicherte Arbeit), geht verloren. Dateien und Volumes bleiben erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qui n’est conservé qu’en mémoire (caches, sessions, travail non enregistré) est perdu. Les fichiers et les volumes sont conservés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリ上にしかないもの（キャッシュ、セッション、未保存の作業）は失われます。ファイルとボリュームは保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅保存在内存中的内容（缓存、会话、未存储的工作）会丢失。文件和卷会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只保存在記憶體中的內容（快取、工作階段、未儲存的工作）都會遺失。檔案和磁碟區會保留。"
          }
        }
      }
    },
