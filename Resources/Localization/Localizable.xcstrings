      }
    },
    "Privileged mode isn't supported; the container runs unprivileged. Grant specific capabilities with --cap-add if it needs them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der privilegierte Modus wird nicht unterstützt; der Container läuft ohne Privilegien. Erteile ihm bei Bedarf gezielt Capabilities mit --cap-add."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode privilégié n’est pas pris en charge ; le conteneur s’exécute sans privilèges. Accordez-lui des capacités précises avec --cap-add s’il en a besoin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "特権モードはサポートされていません。コンテナは非特権で実行されます。必要な場合は、--cap-addで特定のケーパビリティを付与してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
