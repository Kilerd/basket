          }
        }
      }
    },
    "The downloaded update doesn't match its published checksum. It may have been altered, so it was deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das heruntergeladene Update stimmt nicht mit seiner veröffentlichten Prüfsumme überein. Es wurde möglicherweise verändert und daher gelöscht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mise à jour téléchargée ne correspond pas à sa somme de contrôle publiée. Elle a pu être altérée ; elle a donc été supprimée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードしたアップデートが、公開されているチェックサムと一致しません。改ざんされている可能性があるため、削除しました。"
