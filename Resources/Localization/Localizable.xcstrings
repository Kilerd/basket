          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Basket doesn't build images; it runs %1$@. Build it first if it isn't in a registry: container build -t %2$@ %3$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basket ne génère pas d’images ; il exécute %1$@. Générez d’abord l’image si elle ne se trouve pas dans un registre : container build -t %2$@ %3$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basketはイメージをビルドせず、%1$@を実行します。レジストリにない場合は、先にビルドしてください：container build -t %2$@ %3$@"
          }
        },
        "zh-Hans" : {
