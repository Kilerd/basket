    "Memory VMs still hold after their guests freed it. A VM only gives it back when it restarts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeitsspeicher, den VMs noch halten, nachdem ihre Gäste ihn freigegeben haben. Eine VM gibt ihn erst bei einem Neustart zurück."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mémoire que les VM conservent après sa libération par leurs invités. Une VM ne la rend qu’à son redémarrage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲストが解放した後も仮想マシンが保持しているメモリ。仮想マシンは再起動しない限り返しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机已释放、但虚拟机仍占用的内存。虚拟机只有在重新启动时才会归还它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虛擬機器在客體釋放後仍佔用的記憶體。虛擬機器只有在重新啟動時才會歸還它。"
          }
        }
      }
    },
