    "Pulled images can be pulled again; ones built or loaded on this Mac are gone for good." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus einer Registry geladene Images können erneut geladen werden; auf diesem Mac gebaute oder aus Archiven geladene sind endgültig weg."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images récupérées peuvent l’être à nouveau ; celles générées ou chargées sur ce Mac sont définitivement perdues."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プルしたイメージは再びプルできますが、このMacでビルドまたは読み込んだイメージは完全に失われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拉取的镜像可以重新拉取；在这台 Mac 上构建或载入的镜像将永久消失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拉取的映像檔可以再次拉取；在這台 Mac 上建置或載入的映像檔將永久消失。"
          }
        }
      }
    },
