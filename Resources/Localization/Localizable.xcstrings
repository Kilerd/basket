    "%@ already holds only this Mac's platform." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ enthält bereits nur die Plattform dieses Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne contient déjà que la plateforme de ce Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
