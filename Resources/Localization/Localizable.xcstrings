    "Host networking isn't supported: the container gets its own IP on Basket's default network. Publish the ports it listens on instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Host-Netzwerk wird nicht unterstützt: Der Container erhält eine eigene IP im Standardnetzwerk von Basket. Veröffentliche stattdessen die Ports, auf denen er lauscht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode réseau hôte n’est pas pris en charge : le conteneur obtient sa propre adresse IP sur le réseau par défaut de Basket. Publiez plutôt les ports sur lesquels il écoute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストネットワークはサポートされていません。コンテナにはBasketのデフォルトネットワーク上の独自のIPが割り当てられます。代わりに、コンテナが待ち受けるポートを公開してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持主机网络：容器会在 Basket 的默认网络上获得自己的 IP。请改为发布它监听的端口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支援主機網路：容器會在 Basket 的預設網路上取得自己的 IP。請改為發佈它所監聽的連接埠。"
          }
        }
      }
    },
