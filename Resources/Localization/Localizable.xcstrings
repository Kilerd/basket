    "About %@ stranded: the VM still holds memory its guest has freed. Restart the container to return it to macOS." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa %@ blockiert: Die VM hält noch Arbeitsspeicher, den ihr Gast freigegeben hat. Starte den Container neu, um ihn an macOS zurückzugeben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ %@ de mémoire bloquée : la VM conserve de la mémoire que son invité a libérée. Redémarrez le conteneur pour la rendre à macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "約%@が滞留しています：ゲストが解放したメモリを仮想マシンがまだ保持しています。コンテナを再起動するとmacOSに返されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "约 %@ 滞留：虚拟机仍占用着客户机已释放的内存。重新启动容器即可将其归还给 macOS。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "約 %@ 滯留：虛擬機器仍佔用其客體已釋放的記憶體。重新啟動容器即可將它歸還給 macOS。"
          }
        }
      }
    },
