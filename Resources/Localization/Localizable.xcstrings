    "Volumes are sparse disk images: they only take the space you actually write." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volumes sind mitwachsende Festplattenimages: Sie belegen nur den Platz, den du tatsächlich schreibst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les volumes sont des images disque fragmentées : ils n’occupent que l’espace que vous écrivez réellement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボリュームはスパースディスクイメージです：実際に書き込んだ分だけ領域を使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卷是稀疏磁盘映像：只占用你实际写入的空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁碟區是稀疏磁碟映像檔：只會佔用你實際寫入的空間。"
          }
        }
      }
    },
    "Volumes keep data across container restarts. They are sparse: a %@ volume only uses what you write." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volumes behalten Daten über Container-Neustarts hinweg. Sie wachsen mit: Ein Volume mit %@ belegt nur, was du schreibst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les volumes conservent les données entre les redémarrages des conteneurs. Ce sont des images fragmentées : un volume de %@ n’utilise que ce que vous écrivez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボリュームはコンテナを再起動してもデータを保持します。スパースなので、%@のボリュームでも書き込んだ分しか使用しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卷可在容器重新启动后保留数据。卷是稀疏的：一个 %@ 的卷只占用你写入的部分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁碟區會在容器重新啟動後保留資料。它們是稀疏的：%@ 的磁碟區只會使用你寫入的空間。"
          }
        }
      }
    },
