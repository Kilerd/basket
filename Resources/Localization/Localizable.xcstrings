    "This build of Basket has no release version, so it can't update itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Build von Basket hat keine Release-Version und kann sich daher nicht selbst aktualisieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette copie de Basket n’a pas de numéro de version publiée ; elle ne peut donc pas se mettre à jour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このBasketのビルドにはリリースバージョンがないため、自身をアップデートできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Basket 版本没有正式发布版本号，因此无法自行更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Basket 建置版本沒有發行版本號碼，因此無法自行更新。"
          }
        }
      }
    },
    "This copy of Basket is signed ad hoc (a development build or a fork), so it can't verify updates. Get new versions from GitHub Releases." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Kopie von Basket ist ad hoc signiert (ein Entwicklungs-Build oder ein Fork) und kann daher keine Updates überprüfen. Neue Versionen findest du unter GitHub Releases."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette copie de Basket est signée ad hoc (version de développement ou fork) ; elle ne peut donc pas vérifier les mises à jour. Téléchargez les nouvelles versions depuis GitHub Releases."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このBasketはアドホック署名されている（開発用ビルドまたはフォーク）ため、アップデートを検証できません。新しいバージョンはGitHub Releasesから入手してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Basket 副本使用 ad hoc 签名（开发版本或复刻版本），因此无法验证更新。请从 GitHub Releases 获取新版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這份 Basket 是以 ad hoc 方式簽署的（開發版本或 fork），因此無法驗證更新項目。請從 GitHub Releases 取得新版本。"
          }
        }
      }
    },
    "This copy of Basket isn't code signed (a development build), so it can't verify updates. Get new versions from GitHub Releases." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Kopie von Basket ist nicht codesigniert (ein Entwicklungs-Build) und kann daher keine Updates überprüfen. Neue Versionen findest du unter GitHub Releases."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette copie de Basket n’a pas de signature de code (version de développement) ; elle ne peut donc pas vérifier les mises à jour. Téléchargez les nouvelles versions depuis GitHub Releases."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このBasketはコード署名されていない（開発用ビルド）ため、アップデートを検証できません。新しいバージョンはGitHub Releasesから入手してください。"
          }
        },
