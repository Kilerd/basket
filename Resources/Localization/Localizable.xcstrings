    "Privileged mode isn't supported; add the specific capabilities with cap_add instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der privilegierte Modus wird nicht unterstützt; füge stattdessen die benötigten Capabilities mit cap_add hinzu."
          }
        },
        "fr" : {
          "stringUnit" : {
