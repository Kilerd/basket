    "Distribution" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distribution"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distribution"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディストリビューション"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发行版"
          }
