{
  "sourceLanguage" : "en",
  "strings" : {
    "%@" : {

    },
    "%@\n\nInstalling quits Basket, which would stop this. Finish or cancel it, then install the update." : {
      "comment" : "The placeholder lists the work in progress, one line each"
    },
    "%@ %@ run another platform's variant: recreating them will need a pull." : {
      "comment" : "The first %@ is the previous sentence (“Used by …; they keep working.”)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ run another platform's variant: recreating them will need a pull."
          }
        }
      }
    },
    "%@ %@ runs another platform's variant: recreating it will need a pull." : {
      "comment" : "The first %@ is the previous sentence (“Used by …; they keep working.”)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ runs another platform's variant: recreating it will need a pull."
          }
        }
      }
    },
    "%@ (%@)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@）"
          }
        }
      }
    },
    "%@ (%@) is the copy kept when keeping one platform was interrupted. If the image in Basket is missing or broken, this is the only way to get it back without a pull." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@) is the copy kept when keeping one platform was interrupted. If the image in Basket is missing or broken, this is the only way to get it back without a pull."
          }
        }
      }
    },
    "%@ (%@, read-only)" : {
      "comment" : "A mount: source (kind, e.g. “volume” or “bind”)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@, read-only)"
          }
        }
      }
    },
    "%@ A copy of the image is kept at %@ — load it with: container image load --input %@" : {
      "comment" : "1: what went wrong (a sentence), 2: folder of the kept archive, 3: the archive path for the command",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Eine Kopie des Images liegt unter %2$@ – lade sie mit: container image load --input %3$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ A copy of the image is kept at %2$@ — load it with: container image load --input %3$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Une copie de l’image est conservée dans %2$@ — pour la charger : container image load --input %3$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ イメージのコピーが%2$@に保存されています。次のコマンドで読み込めます：container image load --input %3$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 镜像副本保留在 %2$@，可使用以下命令载入：container image load --input %3$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 映像檔的拷貝保留在 %2$@，可用以下指令載入：container image load --input %3$@"
          }
        }
      }
    },
    "%@ Basket was not changed. Please report this (see SECURITY.md in the Basket repository)." : {
      "comment" : "The placeholder is the failed check, a full sentence"
    },
    "%@ Images were kept: %@" : {
      "comment" : "The first %@ is the previous sentence; the second explains why images were kept",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ Images were kept: %2$@"
          }
        }
      }
    },
    "%@ Nothing is removed until Basket can read every machine; try again in a moment, or delete images one by one." : {
      "comment" : "%@ is a sentence explaining why (for example, a machine couldn't be inspected)"
    },
    "%@ Nothing was changed." : {
