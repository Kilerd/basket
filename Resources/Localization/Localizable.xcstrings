    "Project “%@”" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt „%@“"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projet « %@ »"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクト「%@」"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目“%@”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專案「%@」"
          }
        }
      }
    },
    "Project “%@” already exists: Up starts its stopped services and leaves running ones as they are. Take it down first to apply changes to the file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt „%@“ existiert bereits: „Up“ startet seine gestoppten Dienste und lässt laufende unverändert. Fahre es zuerst herunter („Down“), um Änderungen an der Datei zu übernehmen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le projet « %@ » existe déjà : Up démarre ses services arrêtés et laisse tels quels ceux en cours d’exécution. Exécutez d’abord Down pour appliquer les modifications du fichier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクト「%@」はすでに存在します：「Up」は停止しているサービスを起動し、実行中のサービスはそのままにします。ファイルの変更を適用するには、先に「Down」を実行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目“%@”已存在：Up 会启动其已停止的服务，正在运行的服务保持不变。若要应用文件中的更改，请先对其执行 Down。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專案「%@」已存在：Up 會啟動已停止的服務，並讓執行中的服務維持原狀。若要套用檔案中的變更，請先將它關閉。"
          }
        }
      }
    },
    "Provide a docker command" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "docker-Befehl bereitstellen"
