    "Frees about %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt etwa %@ frei"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libère environ %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "約%@を解放"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "约释放 %@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "約可釋放 %@"
          }
        }
      }
    },
    "Frees about %@. Pulled images can be pulled again; images built or loaded on this Mac are gone for good." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt etwa %@ frei. Aus einer Registry geladene Images können erneut geladen werden; auf diesem Mac gebaute oder aus Archiven geladene sind endgültig weg."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libère environ %@. Les images récupérées peuvent l’être à nouveau ; celles générées ou chargées sur ce Mac sont définitivement perdues."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "約%@を解放します。プルしたイメージは再びプルできますが、このMacでビルドまたは読み込んだイメージは完全に失われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "约释放 %@。拉取的镜像可以重新拉取；在这台 Mac 上构建或载入的镜像将永久消失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "約可釋放 %@。拉取的映像檔可以再次拉取；在這台 Mac 上建置或載入的映像檔將永久消失。"
          }
        }
      }
    },
    "Frees up to %@. Images built or loaded on this Mac can't be pulled again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt bis zu %@ frei. Auf diesem Mac gebaute oder aus Archiven geladene Images können nicht erneut geladen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libère jusqu’à %@. Les images générées ou chargées sur ce Mac ne peuvent pas être récupérées à nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大%@を解放します。このMacでビルドまたは読み込んだイメージは再びプルできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多释放 %@。在这台 Mac 上构建或载入的镜像无法重新拉取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多可釋放 %@。在這台 Mac 上建置或載入的映像檔無法再次拉取。"
          }
        }
      }
    },
