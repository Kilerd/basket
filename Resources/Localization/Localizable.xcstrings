        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載的更新項目與公開的總和檢查碼不符。它可能已被竄改，因此已將它刪除。"
          }
        }
      }
    },
    "The downloaded update is damaged: %@." : {
