    "Basket couldn't list the machines, so it can't tell which images they boot from." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basket konnte die Maschinen nicht auflisten und kann daher nicht erkennen, von welchen Images sie starten."
          }
