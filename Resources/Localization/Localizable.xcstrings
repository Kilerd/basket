            "value" : "In OrbStack belegter Speicherplatz; der Import kopiert nur die komprimierten Layer für %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espace disque utilisé dans OrbStack ; l’importation ne copie que les couches %@ compressées"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OrbStackでのディスク使用量。読み込みでは、圧縮された%@レイヤだけをコピーします"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 OrbStack 中占用的磁盘空间；导入时只拷贝压缩后的 %@ 层"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 OrbStack 中使用的磁碟空間；匯入時只會拷貝壓縮過的 %@ 層"
          }
        }
      }
    },
