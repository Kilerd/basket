          "stringUnit" : {
            "state" : "translated",
            "value" : "無法重新啟動容器"
          }
        }
      }
    },
    "The container keeps its own name as hostname; “%@” is added to /etc/hosts of the project's containers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Container behält seinen Namen als Hostname; „%@“ wird zu /etc/hosts der Container des Projekts hinzugefügt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le conteneur garde son propre nom comme nom d’hôte ; « %@ » est ajouté au fichier /etc/hosts des conteneurs du projet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテナのホスト名はコンテナ名のままです。「%@」はプロジェクトの各コンテナの/etc/hostsに追加されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容器仍以自身名称作为主机名；“%@”会添加到项目中各容器的 /etc/hosts。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容器會保留自己的名稱作為主機名稱；「%@」會加入專案中各容器的 /etc/hosts。"
          }
        }
      }
    },
    "The container runs in its own lightweight VM. Its memory is returned to macOS when it stops." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Container läuft in einer eigenen leichten VM. Sein Arbeitsspeicher geht an macOS zurück, wenn er stoppt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le conteneur s’exécute dans sa propre VM légère. Sa mémoire est rendue à macOS à son arrêt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテナは独自の軽量な仮想マシンで実行されます。停止するとメモリがmacOSに返されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容器在独立的轻量虚拟机中运行。停止时，其内存会归还给 macOS。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容器在自己的輕量虛擬機器中執行。容器停止時，其記憶體會歸還給 macOS。"
          }
        }
      }
    },
    "The container system didn't report itself as running." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Containersystem hat nicht gemeldet, dass es läuft."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le système de conteneurs ne s’est pas signalé comme en cours d’exécution."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテナシステムが実行中であることを報告しませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容器系统未报告其正在运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容器系統沒有回報為執行中。"
          }
        }
      }
    },
    "The container system is running" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Containersystem läuft"
          }
        },
        "fr" : {
          "stringUnit" : {
