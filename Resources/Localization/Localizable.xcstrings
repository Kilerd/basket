    "Run" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausführen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécuter"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "執行"
          }
        }
      }
    },
    "Run Linux containers on your Mac with Apple’s own container runtime. Each container gets a small virtual machine that uses memory only while it runs, and Basket shows what memory and disk everything costs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe Linux-Container auf deinem Mac mit Apples eigener Container-Laufzeitumgebung aus. Jeder Container erhält eine kleine virtuelle Maschine, die nur Arbeitsspeicher belegt, solange sie läuft, und Basket zeigt, wie viel Arbeitsspeicher und Speicherplatz alles kostet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécutez des conteneurs Linux sur votre Mac avec l’environnement d’exécution de conteneurs d’Apple. Chaque conteneur dispose d’une petite machine virtuelle qui n’utilise de la mémoire que pendant son exécution, et Basket indique ce que tout coûte en mémoire et en disque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple独自のコンテナランタイムで、MacでLinuxコンテナを実行できます。各コンテナには実行中だけメモリを使う小さな仮想マシンが割り当てられ、Basketはすべてのメモリとディスクの使用量を表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Apple 自己的容器运行时在 Mac 上运行 Linux 容器。每个容器都有一个小型虚拟机，只在运行时占用内存；Basket 会显示每项内容占用的内存和磁盘空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Apple 自家的容器執行環境，在你的 Mac 上執行 Linux 容器。每個容器都有一台只在執行時才使用記憶體的小型虛擬機器，而 Basket 會顯示所有項目佔用的記憶體和磁碟空間。"
          }
        }
      }
    },
    "Run Setup Again…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einrichtung erneut ausführen …"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relancer la configuration…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セットアップをもう一度実行…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新运行设置…"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新執行初始設定⋯"
          }
        }
      }
    },
    "Run a container from an image. Each one gets its own lightweight VM with just the memory you give it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe einen Container aus einem Image aus. Jeder erhält eine eigene leichte VM mit genau dem Arbeitsspeicher, den du ihm gibst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécutez un conteneur à partir d’une image. Chacun dispose de sa propre VM légère, avec uniquement la mémoire que vous lui attribuez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イメージからコンテナを実行します。各コンテナには、指定したメモリだけを持つ独自の軽量な仮想マシンが割り当てられます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从镜像运行容器。每个容器都有自己的轻量虚拟机，且只使用你分配给它的内存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從映像檔執行容器。每個容器都有自己的輕量虛擬機器，只使用你分配給它的記憶體。"
          }
        }
      }
    },
    "Run a container from this image" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
