        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basketにはすでに「%1$@」という名前の別のイメージがあります：%2$@。OrbStackのイメージを読み込むには、Basketでそのイメージの名前を変更するか削除してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basket 中已有另一个名为 %1$@ 的镜像：%2$@。若要导入 OrbStack 中的镜像，请先在 Basket 中将其重新命名或删除。"
