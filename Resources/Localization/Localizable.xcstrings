    },
    "This copy of Basket is signed ad hoc (a development build or a fork), so it can't verify updates. Get new versions from GitHub Releases." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Kopie von Basket ist ad hoc signiert (ein Entwicklungs-Build oder ein Fork) und kann daher keine Updates überprüfen. Neue Versionen findest du unter GitHub Releases."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette copie de Basket est signée ad hoc (version de développement ou fork) ; elle ne peut donc pas vérifier les mises à jour. Téléchargez les nouvelles versions depuis GitHub Releases."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このBasketはアドホック署名されている（開発用ビルドまたはフォーク）ため、アップデートを検証できません。新しいバージョンはGitHub Releasesから入手してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Basket 副本使用 ad hoc 签名（开发版本或复刻版本），因此无法验证更新。请从 GitHub Releases 获取新版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這份 Basket 是以 ad hoc 方式簽署的（開發版本或 fork），因此無法驗證更新項目。請從 GitHub Releases 取得新版本。"
          }
        }
      }
    },
    "This copy of Basket isn't code signed (a development build), so it can't verify updates. Get new versions from GitHub Releases." : {
