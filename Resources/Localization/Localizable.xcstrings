    "Anonymous volumes at %@ aren't recreated; their data stays in OrbStack and the container starts with what the image has there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyme Volumes unter %@ werden nicht neu erstellt; ihre Daten bleiben in OrbStack, und der Container startet mit dem, was das Image dort enthält."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les volumes anonymes montés sur %@ ne sont pas recréés ; leurs données restent dans OrbStack et le conteneur démarre avec le contenu de l’image à cet emplacement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の匿名ボリュームは再作成されません。データはOrbStackに残り、コンテナはその場所にイメージが持つ内容で起動します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不会重新创建 %@ 处的匿名卷；其数据保留在 OrbStack 中，容器启动时这些位置只有镜像自带的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不會重新建立位於 %@ 的匿名磁碟區；其資料會留在 OrbStack 中，容器啟動時會使用映像檔在該位置的內容。"
          }
        }
      }
    },
