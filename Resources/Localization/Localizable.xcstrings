    "Exempt containers are never stopped automatically or by “Stop Idle Containers”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgenommene Container werden nie automatisch oder durch „Container im Leerlauf stoppen“ gestoppt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conteneurs exclus ne sont jamais arrêtés automatiquement ni par « Arrêter les conteneurs inactifs »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除外したコンテナは、自動でも「アイドル状態のコンテナを停止」でも停止されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "豁免的容器永远不会被自动停止，也不会被“停止空闲容器”停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已排除的容器永遠不會被自動停止，也不會被「停止閒置容器」停止。"
          }
        }
      }
    },
    "Exempt from Memory Saver" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom Speichersparmodus ausnehmen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclure de l’Économiseur de mémoire"
          }
        },
        "ja" : {
