        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est démarré en premier, mais « %2$@ » ne peut pas être vérifié (pas de contrôle d’intégrité) ; %3$@ démarre dès que %4$@ a démarré."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@が先に起動されますが、「%2$@」は確認できません（ヘルスチェックなし）。%3$@は%4$@の起動後すぐに起動します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 会先启动，但无法检查“%2$@”（不支持健康检查）；%4$@ 一启动，%3$@ 就会立即启动。"
