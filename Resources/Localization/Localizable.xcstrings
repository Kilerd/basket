            "value" : "容器（%lld）"
          }
        }
      }
    },
    "Containers attached to it lose that connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit verbundene Container verlieren diese Verbindung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conteneurs qui y sont rattachés perdent cette connexion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このネットワークに接続しているコンテナは接続を失います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接到它的容器会失去该连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連接到它的容器將失去該連線。"
          }
        }
      }
    },
    "Containers attached to them lose that connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit verbundene Container verlieren diese Verbindung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conteneurs qui y sont rattachés perdent cette connexion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのネットワークに接続しているコンテナは接続を失います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接到它们的容器会失去该连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連接到它們的容器將失去該連線。"
          }
        }
      }
    },
    "Containers keep their own copy of the files and keep working, but nothing new can be created from it until pulled again — and an image built or loaded on this Mac can't be pulled. Delete what uses it first to be safe." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Container behalten ihre eigene Kopie der Dateien und laufen weiter, aber bis zum erneuten Laden kann daraus nichts Neues erstellt werden – und ein auf diesem Mac gebautes oder aus einem Archiv geladenes Image kann nicht erneut geladen werden. Lösche zur Sicherheit zuerst, was es verwendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conteneurs gardent leur propre copie des fichiers et continuent de fonctionner, mais rien de nouveau ne peut être créé à partir de cette image tant qu’elle n’est pas récupérée à nouveau — et une image générée ou chargée sur ce Mac ne peut pas être récupérée. Par précaution, supprimez d’abord ce qui l’utilise."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテナはファイルのコピーを持っているので動作し続けますが、再びプルするまで、このイメージから新しく作成することはできません。また、このMacでビルドまたは読み込んだイメージはプルできません。安全のため、先にこのイメージを使用しているものを削除してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容器保留自己的文件副本并继续运行，但在重新拉取之前，无法再用它创建新的容器或机器；而在这台 Mac 上构建或载入的镜像无法被拉取。为安全起见，请先删除使用它的项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容器會保留自己的檔案拷貝並繼續運作，但在重新拉取之前，無法再從它建立任何新項目；而在這台 Mac 上建置或載入的映像檔無法重新拉取。為了安全起見，請先刪除使用它的項目。"
          }
        }
      }
    },
    "Containers keep their own copy of the files and keep working, but nothing new can be created from them until pulled again — and an image built or loaded on this Mac can't be pulled. Delete what uses them first to be safe." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Container behalten ihre eigene Kopie der Dateien und laufen weiter, aber bis zum erneuten Laden kann daraus nichts Neues erstellt werden – und ein auf diesem Mac gebautes oder aus einem Archiv geladenes Image kann nicht erneut geladen werden. Lösche zur Sicherheit zuerst, was sie verwendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conteneurs gardent leur propre copie des fichiers et continuent de fonctionner, mais rien de nouveau ne peut être créé à partir de ces images tant qu’elles ne sont pas récupérées à nouveau — et une image générée ou chargée sur ce Mac ne peut pas être récupérée. Par précaution, supprimez d’abord ce qui les utilise."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテナはファイルのコピーを持っているので動作し続けますが、再びプルするまで、これらのイメージから新しく作成することはできません。また、このMacでビルドまたは読み込んだイメージはプルできません。安全のため、先にこれらのイメージを使用しているものを削除してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容器保留自己的文件副本并继续运行，但在重新拉取之前，无法再用它们创建新的容器或机器；而在这台 Mac 上构建或载入的镜像无法被拉取。为安全起见，请先删除使用它们的项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容器會保留自己的檔案拷貝並繼續運作，但在重新拉取之前，無法再從它們建立任何新項目；而在這台 Mac 上建置或載入的映像檔無法重新拉取。為了安全起見，請先刪除使用它們的項目。"
          }
        }
      }
    },
    "Containers on the same network can reach each other by IP address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Container im selben Netzwerk erreichen einander über ihre IP-Adresse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conteneurs d’un même réseau peuvent se joindre par adresse IP."
