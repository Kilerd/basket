          }
        }
      }
    },
    "Basket couldn't read which image machine %@ boots from (`container machine inspect` failed), so any image may be in use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basket konnte nicht lesen, von welchem Image die Maschine %@ startet (`container machine inspect` ist fehlgeschlagen); daher könnte jedes Image verwendet werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basket n’a pas pu déterminer à partir de quelle image la machine %@ démarre (échec de `container machine inspect`) ; n’importe quelle image peut donc être utilisée."
          }
        },
        "ja" : {
          "stringUnit" : {
