    "8080:80" : {

    },
    "A brief interruption: each container stops and starts again, usually within seconds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kurze Unterbrechung: Jeder Container stoppt und startet wieder, meist innerhalb von Sekunden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une brève interruption : chaque conteneur s’arrête puis redémarre, généralement en quelques secondes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時的に中断されます：各コンテナが停止して再び起動します。通常は数秒で完了します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短暂中断：每个容器会停止后再次启动，通常在几秒内完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短暫中斷：每個容器會停止後再啟動，通常在幾秒內完成。"
          }
        }
      }
    },
    "A brief interruption: published ports come back once it is running again, but anything kept only in memory is lost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kurze Unterbrechung: Veröffentlichte Ports sind wieder da, sobald er wieder läuft, aber alles, was nur im Arbeitsspeicher liegt, geht verloren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une brève interruption : les ports publiés reviennent dès qu’il fonctionne de nouveau, mais tout ce qui n’est conservé qu’en mémoire est perdu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時的に中断されます：公開ポートは再び実行されると戻りますが、メモリ上にしかないものは失われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短暂中断：它重新运行后，已发布的端口会恢复，但仅保存在内存中的内容会丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短暫中斷：它重新執行後，已發佈的連接埠就會恢復，但只保存在記憶體中的內容都會遺失。"
          }
        }
      }
    },
    "A brief interruption: published ports come back once they are running again, but anything kept only in memory is lost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kurze Unterbrechung: Veröffentlichte Ports sind wieder da, sobald sie wieder laufen, aber alles, was nur im Arbeitsspeicher liegt, geht verloren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une brève interruption : les ports publiés reviennent dès qu’ils fonctionnent de nouveau, mais tout ce qui n’est conservé qu’en mémoire est perdu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時的に中断されます：公開ポートは再び実行されると戻りますが、メモリ上にしかないものは失われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短暂中断：它们重新运行后，已发布的端口会恢复，但仅保存在内存中的内容会丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短暫中斷：它們重新執行後，已發佈的連接埠就會恢復，但只保存在記憶體中的內容都會遺失。"
          }
        }
      }
    },
    "A container named “%@” already exists outside this project. Rename or delete it first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Außerhalb dieses Projekts gibt es bereits einen Container namens „%@“. Benenne ihn zuerst um oder lösche ihn."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un conteneur nommé « %@ » existe déjà en dehors de ce projet. Renommez-le ou supprimez-le d’abord."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」という名前のコンテナがこのプロジェクト外にすでに存在します。先に名前を変更するか削除してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此项目之外已存在名为“%@”的容器。请先将其重新命名或删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專案外已有名為「%@」的容器。請先將它重新命名或刪除。"
          }
        }
      }
    },
    "A full Linux environment that boots in its own VM and shares your home folder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine vollständige Linux-Umgebung, die in einer eigenen VM startet und deinen Benutzerordner teilt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un environnement Linux complet qui démarre dans sa propre VM et partage votre dossier de départ."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "独自の仮想マシンで起動し、ホームフォルダを共有する完全なLinux環境です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在独立虚拟机中启动、并共享你的个人文件夹的完整 Linux 环境。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完整的 Linux 環境，在自己的虛擬機器中開機，並共享你的個人專屬資料夾。"
          }
        }
      }
    },
    "A machine is a full Linux environment with your home folder mounted — like an OrbStack machine, booted on demand." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Maschine ist eine vollständige Linux-Umgebung mit eingebundenem Benutzerordner – wie eine OrbStack-Maschine, die bei Bedarf startet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une machine est un environnement Linux complet avec votre dossier de départ monté — comme une machine OrbStack, démarrée à la demande."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マシンは、ホームフォルダがマウントされた完全なLinux環境です。OrbStackのマシンと同様に、必要なときに起動します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "机器是挂载了你的个人文件夹的完整 Linux 环境，类似于 OrbStack 的机器，按需启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "機器是裝載了你個人專屬資料夾的完整 Linux 環境，就像 OrbStack 的機器，會視需要開機。"
          }
        }
      }
    },
    "API server" : {
