    },
    "Basket can't replace itself in “%@” (no write permission). Move it to a folder you can write to, such as Applications." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basket kann sich in „%@“ nicht selbst ersetzen (keine Schreibrechte). Bewege die App in einen Ordner, in dem du Schreibrechte hast, z. B. „Programme“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basket ne peut pas se remplacer dans « %@ » (pas d’autorisation d’écriture). Déplacez-le dans un dossier où vous pouvez écrire, comme Applications."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basketは「%@」で自身を置き換えられません（書き込み権限がありません）。「アプリケーション」フォルダなど、書き込み可能なフォルダに移動してください。"
