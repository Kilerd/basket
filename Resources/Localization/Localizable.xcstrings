        }
      }
    },
    "%@ set no memory limit. Each container is its own VM, so they get %@ each; set mem_limit to change it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ setzen kein Arbeitsspeicherlimit. Jeder Container ist eine eigene VM, daher erhält jeder %2$@; ändere das mit mem_limit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ set no memory limit. Each container is its own VM, so they get %2$@ each; set mem_limit to change it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne définissent aucune limite de mémoire. Chaque conteneur étant une VM distincte, chacun reçoit %2$@ ; définissez mem_limit pour modifier cette valeur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@にはメモリ上限が設定されていません。各コンテナは独立した仮想マシンなので、それぞれに%2$@が割り当てられます。変更するにはmem_limitを設定してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 未设置内存限制。每个容器都是独立的虚拟机，因此它们各获得 %2$@；如需更改，请设置 mem_limit。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 未設定記憶體限制。每個容器都是獨立的虛擬機器，因此各會取得 %2$@；如要更改，請設定 mem_limit。"
          }
        }
      }
    },
    "%@ sets no memory limit. Each container is its own VM, so it gets %@; set mem_limit to change it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ setzt kein Arbeitsspeicherlimit. Jeder Container ist eine eigene VM, daher erhält er %2$@; ändere das mit mem_limit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ sets no memory limit. Each container is its own VM, so it gets %2$@; set mem_limit to change it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne définit aucune limite de mémoire. Chaque conteneur étant une VM distincte, il reçoit %2$@ ; définissez mem_limit pour modifier cette valeur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@にはメモリ上限が設定されていません。各コンテナは独立した仮想マシンなので、%2$@が割り当てられます。変更するにはmem_limitを設定してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
