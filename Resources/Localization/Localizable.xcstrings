    "The update is unexpectedly large (%@), so Basket stopped downloading it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Update ist unerwartet groß (%@), daher hat Basket den Download abgebrochen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mise à jour est anormalement volumineuse (%@) ; Basket en a donc interrompu le téléchargement."
