            "value" : "Basket 仍在處理作業"
          }
        }
      }
    },
    "Basket isn't running from an app bundle (a development run), so it can't update itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basket wird nicht aus einem App-Bundle ausgeführt (Entwicklungslauf) und kann sich daher nicht selbst aktualisieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basket n’est pas exécuté depuis un paquet d’app (exécution de développement) ; il ne peut donc pas se mettre à jour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basketがアプリケーションバンドルから実行されていない（開発用の実行）ため、自身をアップデートできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basket 并非从 App 包运行（在开发环境中运行），因此无法自行更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
