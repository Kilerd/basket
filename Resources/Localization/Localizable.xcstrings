    "Pull an image to run containers from it. Basket pulls only this Mac's platform by default to save disk." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade ein Image, um Container daraus auszuführen. Basket lädt standardmäßig nur die Plattform dieses Mac, um Speicherplatz zu sparen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupérez une image pour exécuter des conteneurs à partir de celle-ci. Par défaut, Basket ne récupère que la plateforme de ce Mac pour économiser de l’espace disque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イメージをプルすると、そこからコンテナを実行できます。ディスクを節約するため、BasketはデフォルトでこのMacのプラットフォームだけをプルします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拉取镜像以便从中运行容器。为节省磁盘空间，Basket 默认只拉取这台 Mac 的平台。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拉取映像檔以從它執行容器。為了節省磁碟空間，Basket 預設只會拉取這台 Mac 的平台。"
          }
        }
      }
    },
    "Pulled %@" : {
