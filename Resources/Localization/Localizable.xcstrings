    },
    "OrbStack only has the %@ variant of this image, so it runs under Rosetta. Pull the %@ variant for native speed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OrbStack hat nur die Variante %1$@ dieses Images, daher läuft es unter Rosetta. Lade die Variante %2$@ für native Geschwindigkeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OrbStack only has the %1$@ variant of this image, so it runs under Rosetta. Pull the %2$@ variant for native speed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OrbStack ne dispose que de la variante %1$@ de cette image ; le conteneur s’exécute donc sous Rosetta. Récupérez la variante %2$@ pour une vitesse native."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OrbStackにはこのイメージの%1$@バリアントしかないため、Rosettaで実行されます。ネイティブの速度で実行するには、%2$@バリアントをプルしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OrbStack 中只有此镜像的 %1$@ 变体，因此它将通过 Rosetta 运行。拉取 %2$@ 变体可获得原生速度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OrbStack 只有此映像檔的 %1$@ 變體，因此會透過 Rosetta 執行。拉取 %2$@ 變體即可以原生速度執行。"
