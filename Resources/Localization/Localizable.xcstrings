          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已只包含这台 Mac 的平台。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已只包含這台 Mac 的平台。"
          }
        }
      }
    },
    "%@ aren't supported; mount the files with volumes instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ werden nicht unterstützt; binde die Dateien stattdessen mit Volumes ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé %@ n’est pas prise en charge ; montez plutôt les fichiers avec des volumes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はサポートされていません。代わりに、ボリュームでファイルをマウントしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持 %@；请改用卷来挂载这些文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支援 %@；請改用磁碟區裝載這些檔案。"
          }
        }
      }
    },
    "%@ doesn't exist on this Mac (it may be a path inside OrbStack's Linux machine), so it is left out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ existiert nicht auf diesem Mac (vielleicht ein Pfad in der Linux-Maschine von OrbStack) und wird daher weggelassen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’existe pas sur ce Mac (il peut s’agir d’un chemin dans la machine Linux d’OrbStack) ; il est donc omis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はこのMacに存在しないため（OrbStackのLinuxマシン内のパスの可能性があります）、除外されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在这台 Mac 上不存在（可能是 OrbStack Linux 机器内的路径），因此将被省略。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不在這台 Mac 上（可能是 OrbStack Linux 機器內的路徑），因此會略過此路徑。"
          }
        }
      }
    },
    "%@ doesn't exist; Up creates it as an empty directory." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ existiert nicht; „Up“ erstellt ihn als leeren Ordner."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’existe pas ; Up le crée sous forme de dossier vide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は存在しません。「Up」を実行すると、空のディレクトリとして作成されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不存在；执行 Up 时会将其创建为空目录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不存在；Up 會將它建立為空白目錄。"
          }
        }
      }
    },
    "%@ don't exist on this Mac (they may be paths inside OrbStack's Linux machine), so they are left out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ existieren nicht auf diesem Mac (vielleicht Pfade in der Linux-Maschine von OrbStack) und werden daher weggelassen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’existent pas sur ce Mac (il peut s’agir de chemins dans la machine Linux d’OrbStack) ; ils sont donc omis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はこのMacに存在しないため（OrbStackのLinuxマシン内のパスの可能性があります）、除外されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在这台 Mac 上不存在（可能是 OrbStack Linux 机器内的路径），因此将被省略。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不在這台 Mac 上（可能是 OrbStack Linux 機器內的路徑），因此會略過這些路徑。"
          }
        }
      }
    },
    "%@ for %lld services" : {
      "comment" : "Memory limits: total for this many Compose services",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ für %2$lld Dienst"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ für %2$lld Dienste"
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ for %2$lld service"
