    "Running containers are stopped first. Their writable layers are removed; images and volumes are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laufende Container werden zuerst gestoppt. Ihre beschreibbaren Layer werden entfernt; Images und Volumes bleiben erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conteneurs en cours d’exécution sont d’abord arrêtés. Leurs couches inscriptibles sont supprimées ; les images et les volumes sont conservés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中のコンテナは先に停止されます。書き込み可能レイヤは削除されますが、イメージとボリュームは保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在运行的容器会先被停止。其可写层会被移除；镜像和卷会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "執行中的容器會先停止。它們的可寫入層會被移除；映像檔和磁碟區會保留。"
          }
        }
