    },
    "Basket has a different image with this name: %@. It isn't imported or offered for cleanup; rename or delete Basket's to import OrbStack's." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basket hat ein anderes Image mit diesem Namen: %@. Es wird weder importiert noch zum Aufräumen angeboten; benenne das Image in Basket um oder lösche es, um das aus OrbStack zu importieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basket a une autre image portant ce nom : %@. L’image d’OrbStack n’est ni importée ni proposée au nettoyage ; renommez ou supprimez celle de Basket pour importer celle d’OrbStack."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basketにはこの名前の別のイメージがあります：%@。読み込みやクリーンアップの対象にはなりません。OrbStackのイメージを読み込むには、Basketのイメージの名前を変更するか削除してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basket 中有另一个同名镜像：%@。它不会被导入，也不会出现在清理建议中；若要导入 OrbStack 中的镜像，请将 Basket 中的镜像重新命名或删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basket 有另一個同名但不同的映像檔：%@。它不會被匯入，也不會列入清理項目；請重新命名或刪除 Basket 中的映像檔，才能匯入 OrbStack 的映像檔。"
          }
        }
      }
    },
    "Basket has an image with this name that couldn't be compared with OrbStack's" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basket hat ein Image mit diesem Namen, das nicht mit dem aus OrbStack verglichen werden konnte"
