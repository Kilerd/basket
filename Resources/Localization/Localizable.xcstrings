        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未做任何變更。"
          }
        }
      }
    },
    "%@ The original image is unchanged." : {
      "comment" : "The argument is the error message (a sentence)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
