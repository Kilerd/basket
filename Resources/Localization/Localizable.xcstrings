    "OrbStack's Docker engine isn't running. Start OrbStack yourself to migrate; Basket never launches it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Docker-Engine von OrbStack läuft nicht. Starte OrbStack selbst, um zu migrieren; Basket öffnet es nie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le moteur Docker d’OrbStack n’est pas en cours d’exécution. Démarrez OrbStack vous-même pour migrer ; Basket ne le lance jamais."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OrbStackのDockerエンジンが実行されていません。移行するには、OrbStackを自分で起動してください。BasketがOrbStackを起動することはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OrbStack 的 Docker 引擎未运行。若要迁移，请自行启动 OrbStack；Basket 绝不会启动它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OrbStack 的 Docker 引擎未在執行。請自行啟動 OrbStack 以進行移轉；Basket 絕不會啟動它。"
          }
        }
      }
    },
