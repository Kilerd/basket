      }
    },
    "Down… (⌫): delete the project's containers and networks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Down … (⌫): Container und Netzwerke des Projekts löschen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Down… (⌫) : supprimer les conteneurs et les réseaux du projet"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Down…（⌫）：プロジェクトのコンテナとネットワークを削除"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
