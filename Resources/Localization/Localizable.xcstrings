    "Idle for %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit %@ im Leerlauf"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactif depuis %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@前からアイドル状態"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已空闲 %@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已閒置 %@"
          }
        }
      }
    },
    "Idle for %@: under %@ CPU and under %@ per second of network traffic the whole time." : {
      "comment" : "1: a duration, 2: “1%”, 3: “1 KB”",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit %1$@ im Leerlauf: die ganze Zeit unter %2$@ CPU und unter %3$@ pro Sekunde Netzwerkverkehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Idle for %1$@: under %2$@ CPU and under %3$@ per second of network traffic the whole time."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactif depuis %1$@ : moins de %2$@ de CPU et moins de %3$@ par seconde de trafic réseau pendant toute la durée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@前からアイドル状態：その間ずっと、CPUが%2$@未満、ネットワーク通信が毎秒%3$@未満です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已空闲 %1$@：期间 CPU 始终低于 %2$@，网络流量始终低于每秒 %3$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已閒置 %1$@：期間 CPU 一直低於 %2$@，網路流量一直低於每秒 %3$@。"
          }
        }
      }
    },
    "Idle means under 1% CPU and under 1 KB/s of network traffic the whole time. A stopped container returns all its memory to macOS. With the window closed, Basket checks activity once a minute." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Leerlauf heißt: die ganze Zeit unter 1 % CPU und unter 1 KB/s Netzwerkverkehr. Ein gestoppter Container gibt seinen gesamten Arbeitsspeicher an macOS zurück. Bei geschlossenem Fenster prüft Basket die Aktivität einmal pro Minute."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactif signifie moins de 1 % CPU et moins de 1 Ko/s de trafic réseau pendant toute la durée. Un conteneur arrêté rend toute sa mémoire à macOS. Lorsque la fenêtre est fermée, Basket vérifie l’activité une fois par minute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイドル状態とは、1% CPU未満、かつネットワーク通信が毎秒1 KB未満の状態がずっと続いていることです。停止したコンテナはすべてのメモリをmacOSに返します。ウインドウを閉じている間、Basketは1分に1回アクティビティを確認します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空闲是指始终低于 1% CPU，且网络流量始终低于 1 KB/s。停止的容器会将其全部内存归还给 macOS。窗口关闭时，Basket 每分钟检查一次活动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閒置是指期間一直低於 1% CPU，且網路流量一直低於 1 KB/s。停止的容器會將所有記憶體歸還給 macOS。關閉視窗時，Basket 每分鐘檢查一次活動。"
          }
        }
      }
    },
