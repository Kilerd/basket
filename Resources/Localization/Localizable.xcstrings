    "Services find each other by name through entries Basket writes into /etc/hosts of each container when the project starts; apple/container has no DNS between containers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dienste finden einander über ihren Namen durch Einträge, die Basket beim Projektstart in /etc/hosts jedes Containers schreibt; apple/container hat kein DNS zwischen Containern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les services se trouvent par leur nom grâce aux entrées que Basket écrit dans le fichier /etc/hosts de chaque conteneur au démarrage du projet ; apple/container ne fournit pas de DNS entre les conteneurs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サービスは、プロジェクトの起動時にBasketが各コンテナの/etc/hostsに書き込むエントリを使って、名前で互いを見つけます。apple/containerにはコンテナ間のDNSがありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目启动时，Basket 会将条目写入每个容器的 /etc/hosts，服务据此按名称相互查找；apple/container 不提供容器之间的 DNS。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服務透過 Basket 在專案啟動時寫入每個容器 /etc/hosts 的項目，以名稱找到彼此；apple/container 的容器之間沒有 DNS。"
          }
        }
      }
    },
