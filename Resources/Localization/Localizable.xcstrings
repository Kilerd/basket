        }
      }
    },
    "The downloaded app doesn't carry the notarized Developer ID signature of Basket's developer (%@), so it was deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die heruntergeladene App hat keine notarisierte Signatur mit der Developer ID des Basket-Entwicklers (%@) und wurde daher gelöscht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app téléchargée ne porte pas la signature Developer ID notarisée du développeur de Basket (%@) ; elle a donc été supprimée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードしたアプリにはBasketの開発者による公証済みのDeveloper ID署名がないため（%@）、削除しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载的 App 没有 Basket 开发者经过公证的 Developer ID 签名（%@），因此已被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載的 App 沒有 Basket 開發者經過公證的 Developer ID 簽名（%@），因此已將它刪除。"
          }
        }
      }
    },
    "The downloaded app isn't the announced Basket version (%@), so it was deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die heruntergeladene App ist nicht die angekündigte Basket-Version (%@) und wurde daher gelöscht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app téléchargée n’est pas la version de Basket annoncée (%@) ; elle a donc été supprimée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードしたアプリがアップデート情報に記載されたBasketのバージョンと一致しないため（%@）、削除しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载的 App 不是所公布的 Basket 版本（%@），因此已被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載的 App 不是公告的 Basket 版本（%@），因此已將它刪除。"
          }
        }
      }
    },
    "The downloaded update doesn't match its published checksum. It may have been altered, so it was deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das heruntergeladene Update stimmt nicht mit seiner veröffentlichten Prüfsumme überein. Es wurde möglicherweise verändert und daher gelöscht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mise à jour téléchargée ne correspond pas à sa somme de contrôle publiée. Elle a pu être altérée ; elle a donc été supprimée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードしたアップデートが、公開されているチェックサムと一致しません。改ざんされている可能性があるため、削除しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载的更新与发布的校验和不符。它可能已被篡改，因此已被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載的更新項目與公開的總和檢查碼不符。它可能已被竄改，因此已將它刪除。"
          }
        }
      }
    },
    "The downloaded update is damaged: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das heruntergeladene Update ist beschädigt: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mise à jour téléchargée est endommagée : %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードしたアップデートが破損しています：%@。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载的更新已损坏：%@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載的更新項目已損毀：%@。"
          }
        }
      }
    },
    "The downloaded update isn't signed by Basket's maintainer. It may have been altered, so it was deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das heruntergeladene Update ist nicht vom Maintainer von Basket signiert. Es wurde möglicherweise verändert und daher gelöscht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mise à jour téléchargée n’est pas signée par le mainteneur de Basket. Elle a pu être altérée ; elle a donc été supprimée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードしたアップデートはBasketのメンテナによって署名されていません。改ざんされている可能性があるため、削除しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载的更新未经 Basket 维护者签名。它可能已被篡改，因此已被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載的更新項目並非由 Basket 的維護者簽署。它可能已被竄改，因此已將它刪除。"
          }
        }
      }
    },
    "The first start downloads Linux kernel files (about 650 MB) and keeps a 30 MB kernel. On a fast connection that takes a few minutes; later starts take seconds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim ersten Start werden Linux-Kerneldateien heruntergeladen (etwa 650 MB), und ein 30-MB-Kernel bleibt erhalten. Bei einer schnellen Verbindung dauert das ein paar Minuten; spätere Starts dauern Sekunden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le premier démarrage télécharge des fichiers du noyau Linux (environ 650 Mo) et conserve un noyau de 30 Mo. Avec une connexion rapide, cela prend quelques minutes ; les démarrages suivants prennent quelques secondes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初回起動時にLinuxカーネルのファイル（約650 MB）をダウンロードし、30 MBのカーネルを保持します。高速な回線では数分かかります。2回目以降の起動は数秒です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次启动会下载 Linux 内核文件（约 650 MB），并保留一个 30 MB 的内核。在高速网络下需要几分钟；之后的启动只需几秒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次啟動會下載 Linux 核心檔案（約 650 MB），並保留一個 30 MB 的核心。在高速網路下約需幾分鐘；之後的啟動只需幾秒。"
          }
        }
      }
    },
    "The healthcheck isn't supported; Basket won't report the container's health." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Healthcheck wird nicht unterstützt; Basket meldet den Zustand des Containers nicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contrôle d’intégrité n’est pas pris en charge ; Basket n’indiquera pas l’état de santé du conteneur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルスチェックはサポートされていません。Basketはコンテナのヘルス状態を報告しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持健康检查；Basket 不会报告容器的健康状况。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支援健康狀態檢查；Basket 不會回報容器的健康狀態。"
          }
        }
      }
    },
    "The image isn't in OrbStack; `container run` will pull it" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Image ist nicht in OrbStack; `container run` lädt es"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image ne se trouve pas dans OrbStack ; `container run` la récupérera"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イメージがOrbStackにありません。`container run`でプルされます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OrbStack 中没有此镜像；`container run` 将拉取它"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OrbStack 中沒有此映像檔；`container run` 會拉取它"
          }
        }
      }
    },
    "The image isn't listed after loading." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Image wird nach dem Laden nicht aufgelistet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image ne figure pas dans la liste après le chargement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込み後、イメージが一覧に表示されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "载入后，镜像未出现在列表中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "載入後，映像檔未出現在列表中。"
          }
        }
      }
    },
    "The machine's disk and everything installed in it are removed. Your home folder is not affected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Festplatte der Maschine und alles darauf Installierte werden entfernt. Dein Benutzerordner ist nicht betroffen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le disque de la machine et tout ce qui y est installé sont supprimés. Votre dossier de départ n’est pas affecté."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マシンのディスクと、そこにインストールされたものはすべて削除されます。ホームフォルダには影響しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "机器的磁盘及其中安装的所有内容都会被移除。你的个人文件夹不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "機器的磁碟和其中安裝的所有內容都會被移除。你的個人專屬資料夾不受影響。"
          }
        }
      }
    },
    "The mount at %@ isn't a bind, volume or tmpfs mount and is left out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mount unter %@ ist kein Bind-, Volume- oder tmpfs-Mount und wird weggelassen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le montage sur %@ n’est ni un montage de liaison, ni un volume, ni un tmpfs ; il est omis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のマウントはbind、volume、tmpfsのいずれでもないため、除外されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 处的挂载不是绑定挂载、卷挂载或 tmpfs 挂载，因此将被省略。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於 %@ 的裝載不是 bind、volume 或 tmpfs 裝載，因此會略過。"
          }
        }
      }
    },
    "The old variants' space is released the next time an image is deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Platz der alten Varianten wird beim nächsten Löschen eines Images freigegeben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espace des anciennes variantes sera libéré à la prochaine suppression d’une image."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古いバリアントの領域は、次にイメージを削除したときに解放されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旧变体占用的空间会在下次删除镜像时释放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舊變體的空間會在下次刪除映像檔時釋放。"
          }
        }
      }
    },
    "The project has no volumes to delete." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Projekt hat keine Volumes, die gelöscht werden könnten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le projet n’a aucun volume à supprimer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロジェクトには削除するボリュームがありません。"
