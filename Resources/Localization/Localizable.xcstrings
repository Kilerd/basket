    },
    "The container CLI kept the other platform variants of %@; nothing was removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die container-CLI hat die anderen Plattformvarianten von %@ behalten; es wurde nichts entfernt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La CLI container a conservé les autres variantes de plateforme de %@ ; rien n’a été supprimé."
          }
        },
        "ja" : {
          "stringUnit" : {
