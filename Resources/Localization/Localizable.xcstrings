    "Take “%@” down?" : {
      "comment" : "Compose project: stop and remove its containers and networks (`compose down`)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ herunterfahren?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécuter Down sur « %@ » ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の「Down」を実行しますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要对“%@”执行 Down 吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要關閉「%@」嗎？"
          }
        }
      }
    },
    "That’s OrbStack’s. New terminals will use Basket’s docker; OrbStack’s stays at %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist der von OrbStack. Neue Terminals verwenden den docker-Befehl von Basket; der von OrbStack bleibt unter %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est celle d’OrbStack. Les nouveaux terminaux utiliseront le docker de Basket ; celui d’OrbStack reste dans %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それはOrbStackのものです。新しいターミナルではBasketのdockerが使われます。OrbStackのdockerは%@に残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是 OrbStack 的 docker。新的终端将使用 Basket 的 docker；OrbStack 的 docker 仍保留在 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那是 OrbStack 的 docker。新的終端機將使用 Basket 的 docker；OrbStack 的仍保留在 %@。"
          }
        }
      }
    },
    "The OrbStack container is running and holds %@. Stop it in OrbStack before starting the Basket copy, or change the ports." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der OrbStack-Container läuft und belegt %@. Stoppe ihn in OrbStack, bevor du die Kopie in Basket startest, oder ändere die Ports."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le conteneur OrbStack est en cours d’exécution et occupe %@. Arrêtez-le dans OrbStack avant de démarrer la copie Basket, ou changez les ports."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OrbStackのコンテナが実行中で、%@を使用しています。Basketのコピーを起動する前にOrbStackでコンテナを停止するか、ポートを変更してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OrbStack 中的容器正在运行并占用了 %@。请先在 OrbStack 中停止它，再启动 Basket 中的副本，或者更改端口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OrbStack 容器正在執行並佔用 %@。請先在 OrbStack 中停止它，再啟動 Basket 中的拷貝，或更改連接埠。"
          }
        }
      }
    },
    "The VM can use up to this much memory; most containers need far less than %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM kann bis zu so viel Arbeitsspeicher nutzen; die meisten Container brauchen weit weniger als %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM peut utiliser jusqu’à cette quantité de mémoire ; la plupart des conteneurs ont besoin de bien moins de %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンはこの量までメモリを使用できます。ほとんどのコンテナに必要なのは%@よりはるかに少ない量です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机最多可以使用这么多内存；大多数容器所需的内存远少于 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虛擬機器最多可使用這麼多記憶體；大多數容器所需的遠少於 %@。"
          }
        }
      }
    },
    "The `container` CLI was not found (looked in %@). Install it with `brew install container`." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die `container`-CLI wurde nicht gefunden (gesucht in %@). Installiere sie mit `brew install container`."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La CLI `container` est introuvable (emplacements vérifiés : %@). Installez-la avec `brew install container`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`container` CLIが見つかりませんでした（検索場所：%@）。`brew install container`でインストールしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到 `container` CLI（已查找 %@）。请使用 `brew install container` 安装。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到 `container` CLI（已搜尋 %@）。請使用 `brew install container` 安裝。"
          }
        }
      }
    },
    "The archive can't be read; it can only be deleted" : {
