{
  "sourceLanguage" : "en",
  "strings" : {
    "%@" : {

    },
    "%@\n\nInstalling quits Basket, which would stop this. Finish or cancel it, then install the update." : {
      "comment" : "The placeholder lists the work in progress, one line each",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nDie Installation beendet Basket und würde das abbrechen. Warte, bis es fertig ist, oder brich es ab, und installiere dann das Update."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nL’installation quitte Basket, ce qui interromprait ce travail. Terminez-le ou annulez-le, puis installez la mise à jour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nインストールするとBasketが終了するため、この処理も停止します。完了するかキャンセルしてから、アップデートをインストールしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n安装会退出 Basket，从而中断上述操作。请等待其完成或将其取消，然后再安装更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n安裝時會結束 Basket，這會中斷上述作業。請先完成或取消它，然後再安裝更新項目。"
          }
        }
      }
    },
    "%@ %@ run another platform's variant: recreating them will need a pull." : {
      "comment" : "The first %@ is the previous sentence (“Used by …; they keep working.”)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ verwenden die Variante einer anderen Plattform: Zum Neuerstellen muss das Image erneut geladen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ run another platform's variant: recreating them will need a pull."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ exécutent la variante d’une autre plateforme : les recréer nécessitera de récupérer l’image."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@はほかのプラットフォームのバリアントを実行しているため、再作成するにはプルが必要になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@ 运行的是其他平台的变体：重新创建它们时需要拉取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@ 執行的是其他平台的變體：重新建立它們時需要拉取。"
          }
        }
      }
    },
    "%@ %@ runs another platform's variant: recreating it will need a pull." : {
      "comment" : "The first %@ is the previous sentence (“Used by …; they keep working.”)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ verwendet die Variante einer anderen Plattform: Zum Neuerstellen muss das Image erneut geladen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ runs another platform's variant: recreating it will need a pull."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ exécute la variante d’une autre plateforme : le recréer nécessitera de récupérer l’image."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@はほかのプラットフォームのバリアントを実行しているため、再作成するにはプルが必要になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@ 运行的是其他平台的变体：重新创建它时需要拉取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@ 執行的是其他平台的變體：重新建立它時需要拉取。"
          }
        }
      }
    },
    "%@ (%@)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@）"
          }
        }
      }
    },
    "%@ (%@) is the copy kept when keeping one platform was interrupted. If the image in Basket is missing or broken, this is the only way to get it back without a pull." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) ist die Kopie, die aufbewahrt wurde, als das Verschlanken auf eine Plattform unterbrochen wurde. Fehlt das Image in Basket oder ist es beschädigt, kannst du es nur so ohne erneutes Laden zurückholen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@) is the copy kept when keeping one platform was interrupted. If the image in Basket is missing or broken, this is the only way to get it back without a pull."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) est la copie conservée lors de l’interruption d’un allègement. Si l’image dans Basket est absente ou endommagée, c’est le seul moyen de la retrouver sans la récupérer à nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@）は、プラットフォームを1つだけ残す処理が中断されたときに保存されたコピーです。Basketのイメージがない、または壊れている場合、プルせずに元に戻す方法はこれしかありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@）是“仅保留一个平台”操作中断时留下的副本。如果 Basket 中的镜像丢失或损坏，这是无需拉取即可恢复它的唯一方法。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@）是只保留一個平台的作業中斷時留下的拷貝。如果 Basket 中的映像檔遺失或損毀，這是不必重新拉取就能取回它的唯一方法。"
          }
        }
      }
    },
    "%@ (%@, read-only)" : {
      "comment" : "A mount: source (kind, e.g. “volume” or “bind”)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@, schreibgeschützt)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@, read-only)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@, lecture seule)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@、読み出し専用）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@，只读）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@，唯讀）"
          }
        }
      }
    },
    "%@ A copy of the image is kept at %@ — load it with: container image load --input %@" : {
      "comment" : "1: what went wrong (a sentence), 2: folder of the kept archive, 3: the archive path for the command",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Eine Kopie des Images liegt unter %2$@ – lade sie mit: container image load --input %3$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ A copy of the image is kept at %2$@ — load it with: container image load --input %3$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Une copie de l’image est conservée dans %2$@ — pour la charger : container image load --input %3$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ イメージのコピーが%2$@に保存されています。次のコマンドで読み込めます：container image load --input %3$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 镜像副本保留在 %2$@，可使用以下命令载入：container image load --input %3$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 映像檔的拷貝保留在 %2$@，可用以下指令載入：container image load --input %3$@"
          }
        }
      }
    },
    "%@ Basket was not changed. Please report this (see SECURITY.md in the Basket repository)." : {
      "comment" : "The placeholder is the failed check, a full sentence",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Basket wurde nicht verändert. Bitte melde das (siehe SECURITY.md im Basket-Repository)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Basket n’a pas été modifié. Veuillez signaler ce problème (voir SECURITY.md dans le dépôt de Basket)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Basketは変更されていません。この問題を報告してください（BasketリポジトリのSECURITY.mdを参照）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Basket 保持不变。请报告此问题（参见 Basket 仓库中的 SECURITY.md）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Basket 維持不變。請回報此問題（請參閱 Basket 儲存庫中的 SECURITY.md）。"
          }
        }
      }
    },
    "%@ Images were kept: %@" : {
      "comment" : "The first %@ is the previous sentence; the second explains why images were kept",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Images wurden behalten: %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ Images were kept: %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Les images ont été conservées : %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@イメージは残しました：%2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@镜像已保留：%2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@已保留映像檔：%2$@"
          }
        }
      }
    },
    "%@ Nothing is removed until Basket can read every machine; try again in a moment, or delete images one by one." : {
      "comment" : "%@ is a sentence explaining why (for example, a machine couldn't be inspected)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Es wird nichts entfernt, bis Basket alle Maschinen lesen kann; versuche es gleich noch einmal oder lösche Images einzeln."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Rien n’est supprimé tant que Basket ne peut pas lire chaque machine ; réessayez dans un instant ou supprimez les images une par une."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Basketがすべてのマシンを読み取れるまで、何も削除しません。しばらくしてからもう一度試すか、イメージを1つずつ削除してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@在 Basket 能读取所有机器之前，不会移除任何内容；请稍后重试，或逐个删除镜像。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@在 Basket 能讀取每台機器之前，不會移除任何項目；請稍後再試，或逐一刪除映像檔。"
          }
        }
      }
    },
    "%@ Nothing was changed." : {
      "comment" : "The argument is the error message (a sentence)",
